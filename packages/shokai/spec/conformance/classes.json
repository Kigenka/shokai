{
  "_about": "Conformance classes and named extensions for Shōkai v0.5.0 (SPEC §0.1, Appendix F). 'sections' and 'extensions' are edited by hand; 'checks', 'tests' and 'vectors' are GENERATED by tools/conformance-classes.mjs (do not edit them; run the tool). trace-lint R8 checks this file is current, that every check has exactly one class, and that every normative line sits in a section with a class.",
  "statuses": {
    "stable": "Complete, implemented and tested in the reference. Within a version line it changes only for fixes; an incompatible change needs a new version, a CHANGELOG entry and the wire-tag transition of §11.1.",
    "provisional": "Normative and tested whenever an implementation claims it, but its members, codes and checks may change incompatibly in the next version, with no transition window. Opt-in: no core class and no stable extension requires it. It becomes stable only through a version release recorded in the CHANGELOG.",
    "experimental": "Specified with little or no implementation. Never part of a conformance claim; it may change or go."
  },
  "core_classes": {
    "core-door": "Core Door: a place's door and host representative (a browse-only, non-spending place qualifies). Every core check with role door or both.",
    "core-visitor": "Core Visitor: a visiting representative. Every core check with role visitor or both."
  },

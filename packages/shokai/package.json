{
  "name": "@kigenka/shokai",
  "version": "0.5.1",
  "description": "Agents, introduced properly. Reference TypeScript SDK for Sh\u014dkai, the open protocol that gives online places a door for agents: signed Sh\u014dkai cards, vouches and envelopes, door policy, visit reports, and a gate that puts a Sh\u014dkai door in front of any MCP server.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./mcp": {
      "types": "./dist/src/mcp.d.ts",
      "default": "./dist/src/mcp.js"
    },
    "./core": {
      "types": "./dist/src/core/index.d.ts",
      "default": "./dist/src/core/index.js"
    },
    "./conformance": {
      "types": "./dist/src/conformance/runner.d.ts",
      "default": "./dist/src/conformance/runner.js"
    },
    "./browser": {
      "types": "./dist/src/browser.d.ts",
      "default": "./dist/src/browser.js"
    },
    "./schema.json": "./spec/schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "shokai": "dist/src/cli.js",
    "shokai-conformance": "dist/src/conformance/cli.js"
  },
  "files": [
    "dist/src",
    "src",
    "dist/examples",
    "conformance-data",
    "agent-install",
    "spec",
    "README.md",
    "LICENSE",
    "LICENSE-docs",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "shokai",
    "agents",
    "mcp",
    "agent-to-agent",
    "protocol",
    "passkeys",
    "introductions"
  ],
  "scripts": {
    "sync": "node scripts/sync-core.mjs",
    "check-sync": "node scripts/sync-core.mjs --check",
    "build": "tsc -p .",
    "prepack": "node scripts/sync-core.mjs --check && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p .",
    "test": "node scripts/sync-core.mjs --check && tsc -p . && node scripts/test-total.mjs",
    "example": "tsc -p . && node dist/examples/toy-mcp/run.js",
    "demo": "tsc -p . && node dist/src/cli.js demo",
    "test:upstash": "tsc -p . && node dist/test/upstash.integration.test.js"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.12.0 <2"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "2.1.8",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^22.20.5",
    "express": "5.3.0",
    "hono": "4.13.14",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  },
  "author": "Yu Sung Yeh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kigenka/shokai.git",
    "directory": "packages/shokai"
  },
  "homepage": "https://github.com/Kigenka/shokai/tree/main/packages/shokai#readme",
  "bugs": {
    "url": "https://github.com/Kigenka/shokai/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "latest"
  }
}

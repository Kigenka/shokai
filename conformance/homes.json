  "suites": {
    "_how": "A test result's home is its group's home. For groups marked 'core*' (mixed groups), a check whose own description (not its group name) matches a keyword rule goes to the first matching rule's home instead; the first rule keeps 'no data for a gift' checks in the core. scripts/suite-split.mjs applies this.",
    "keyword_rules": [
      [
        "core",
        "may never cost|no_data_for_gift|no data for gifts?"
      ],
      [
        "visit-receipts",
        "\\breceipt|visit_receipt|continuity|links nothing|proven echo|lobby history merged|invalid echoes"
      ],
      [
        "gatherings",
        "gathering|\\bpress(es|ed|ing)?\\b|room item|house rule|privacy_decline|\\btopic|takeaway|attendee|\\bB\\.3\\b|\\bstory"
      ],
      [
        "peer-meetings",
        "\\bpair\\b|peer_invitation|peer invitation|\\bB\\.2\\b|test owner|accept_invitation"
      ],
      [
        "door-gifts",
        "\\bgifts?\\b|claim_ticket"
      ],
      [
        "signed-listings",
        "signed listing|SignedPlaceListing"
      ],
      [
        "revocation-status",
        "AllowanceStatus|allowance_status|stapled status|\\bD12\\b|C132"
      ],
      [
        "meaning-notes",
        "meaning note|MeaningNote"
      ],
      [
        "profiles-and-evidence",
        "imprint|evidenced|facet"
      ]
    ],

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "rootDir": "../..",
    "outDir": "dist",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false
  },

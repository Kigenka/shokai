# dependencies and build output
node_modules/
dist/
*.tgz
# …except the release artefact release.yml publishes (committed with its sidecar)
!release/*.tgz
!release/*.sha256

# local state, keys and secrets (never commit)
state/
keys/
run/
*.pem
*.key
.env
.env*
.shokai/

# OS / editor
.DS_Store
*.log

# Vercel CLI link folders (deploy/sign-preview)
.vercel/

# serverless signing page: local harness data
deploy/sign-serverless/run-data/
tools/attack-harness/results/

# local key stores from demos/workshops (never commit)
workshop/
**/desk/*.json
*.pkcs8

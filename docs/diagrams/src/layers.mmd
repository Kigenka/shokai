flowchart TD
  subgraph A["Who is behind the agent"]
    direction TD
    O["Owner<br/>signs with a passkey"] --> R["Representative,<br/>host or visiting:<br/>its own key and card"]
  end

  subgraph B["Transport identity, optional"]
    direction TD
    WBA["Web Bot Auth:<br/>which software sent this request"] --> OA["OAuth or TLS:<br/>which client, which session"]
  end

  subgraph C["Shōkai: the door"]
    direction TD
    C1["Who it's here for:<br/>self-introduction,<br/>owner-signed visitor card"] --> C2["Why it came:<br/>purpose, and a signed<br/>introduction only if the door asks"]
    C2 --> C3["What it may do:<br/>owner-signed limits"]
    C3 --> C4["Decision and pass,<br/>with reasons"]
    C4 --> C5["Conduct,<br/>remembered at this door"]
  end

  subgraph D["After admission: the work"]
    direction TD
    M["MCP servers: tools and data"] --> A2A["A2A agents: tasks"]
    A2A --> API["The place's own APIs"]
    API --> PAY["Payments: AP2, Stripe, ACP"]
  end

  A --> B --> C --> D
  classDef shokai fill:#2c4a6c,stroke:#2c4a6c,color:#fbf9f4
  class C1,C2,C3,C4,C5 shokai

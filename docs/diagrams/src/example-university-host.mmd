  C -- "admitted student" --> E["Enrolment seat<br/>with the offer of admission,<br/>the university's own invitation"]
  P -. "applies; admissions decides" .-> E
  E --> CD{"Course door<br/>kept by a faculty member's<br/>host representative"}
  CD -- "grant" --> S["Course seat<br/>materials · submit · own grades<br/>· office hours"]
  CD -- "another student's records" --> X["Refused, with a reason"]
  S --> R["The room inside<br/>study groups, card exchange,<br/>a classmate's vouch"]
  C -- "every decision" --> K["Records at each door<br/>per counterpart, kept by<br/>each host representative"]
  CD -- "every decision" --> K

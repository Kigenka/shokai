flowchart LR
  U["Sorawick Online University<br/>(fictional; the owner)"] -- "signs the campus Shōkai host card,<br/>sets the door policy" --> C
  A["Arrivals<br/>read the campus window:<br/>programmes, what enrolment asks"] --> C{"Campus host representative<br/>admissions and registrar<br/>checks the Shōkai visitor card<br/>and the possession proof"}
  C -. "no Shōkai visitor card" .-> L["The leaflet<br/>what's needed, a sentence<br/>for the owner, a kind not now"]
  C -- "prospective student" --> P["Narrow pass (wire: seat)<br/>look around, ask, apply<br/>not a student's records"]
  C -- "admitted student" --> E["Enrolment pass<br/>with the offer of admission,<br/>the university's own invitation"]
  P -. "applies; admissions decides" .-> E
  E --> CD{"Course door<br/>kept by a faculty member's<br/>host representative"}
  CD -- "grant" --> S["Course pass<br/>materials · submit · own grades<br/>· office hours"]
  CD -- "another student's records" --> X["Refused, with a reason"]
  S -. "optional" .-> R["A study room, optional<br/>course doors work without it"]
  C -- "every decision" --> K["Records at each door<br/>per counterpart, kept by<br/>each host representative"]
  CD -- "every decision" --> K

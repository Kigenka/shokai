flowchart TB
  B["A brand's agent representative knocks<br/>with a Shōkai visitor card<br/>at a person's door"]
  P{"Door policy the owner signed<br/>optional vouch?<br/>uninvited allowance left?"}
  B --> P
  P -- "over the allowance, or<br/>introductions only" --> X1["not_now, retry after the next window<br/>no slot used, nothing recorded"]
  P -- "admitted, a pass<br/>(wire: seat)" --> N["Offer is data, not instructions<br/>strip hidden styling<br/>keep what was removed for the owner"]
  N --> Q{"Hard rules first"}
  Q -- "instructions to the agent,<br/>unbacked urgency, claimed consent" --> R1["declined_reported<br/>a misconduct notice<br/>never only for misconduct"]
  Q -- "needs something from the owner,<br/>or hidden text" --> CEIL["ceiling: at most<br/>kept_for_later"]
  Q -- "clean" --> T["Taste: the owner's private likes,<br/>held only by the host representative"]
  CEIL --> T
  T --> O1["accepted"]
  T --> O2["kept_for_later"]
  T --> O3["declined, with a<br/>kind reason category"]
  O1 --> H["Report home and a local record<br/>optional: who vouched, paid or genuine"]
  O2 --> H
  O3 --> H
  R1 --> H
  classDef bad fill:#f3e3dc,stroke:#9c4a32,color:#1d1c1a
  classDef door fill:#2c4a6c,stroke:#2c4a6c,color:#fbf9f4
